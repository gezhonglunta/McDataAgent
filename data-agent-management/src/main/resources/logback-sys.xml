<included>
    <!-- %m输出的信息,%p日志级别,%t线程名,%d日期,%c类的全名,%i索引【从数字0开始递增】,,, -->
    <!-- appender是configuration的子节点，是负责写日志的组件。 -->
    <!-- ConsoleAppender：把日志输出到控制台 -->
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.pattern}</pattern>
            <!-- 控制台也要使用UTF-8，不要使用GBK，否则会中文乱码 -->
            <!--
            <charset>UTF-8</charset>
            -->
        </encoder>
    </appender>

    <!-- 主日志按天滚动输出 -->
    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/data-agent-management.log</file>
        <append>true</append>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/data-agent-management.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Access log 按天滚动输出 -->
    <appender name="accessFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/access.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/access.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 日志级别 -->
    <logger name="ACCESS_LOG" level="info" additivity="false">
        <appender-ref ref="accessFile" />
    </logger>
    <logger name="com.alibaba.cloud.ai.dataagent.service" level="info" />
    <logger name="com.alibaba.cloud.ai.dataagent.workflow.node" level="info" />
    <logger name="com.alibaba.cloud.ai.mapper" level="info" />
    <logger name="org.springframework.jdbc" level="info" />

    <!-- 控制台输出日志级别 -->
    <root level="info">
        <if condition='"ide".equals(property("RUN_MODE"))'>
            <then>
                <appender-ref ref="stdout"/>
            </then>
        </if>
        <appender-ref ref="file"/>
    </root>
</included>
